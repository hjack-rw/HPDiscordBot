# Copy to "env" (no leading dot - see src/variables.py's load_dotenv path) and fill in.
# Never commit the real "env" file - it's gitignored.

# --- Discord ---
DISCORD_BOT_TOKEN=your-bot-token-here

# --- Deploy (health-check port, log access) ---
PORT=8080
LOG_ACCESS_KEY=pick-a-random-secret-for-the-/logs-endpoint
SKIP_ASSET_FETCH=False

# --- Asset seed - required, fetch_assets() falls back to this if no backup exists yet ---
ASSET_ZIP_URL=https://www.dropbox.com/scl/fi/xxxxx/assets.zip?dl=1

# --- Backup rotation - optional, degrades to the seed above if unset. Same 3 creds are
# reused for both writing new backups and reading the latest one back. ---
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token

# --- Local dev only (pre_init.py, excluded from the deploy image) ---
# DEBUG_MODE=True
# GITHUB_CLONE_TOKEN=""
