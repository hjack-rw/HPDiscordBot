# Local/host-only files (never committed, live only on the deploying machine)
.gitignore
pre_init.py
server_config.toml
test.py

# Python artifacts
__pycache__/
src/__pycache__

# Runtime database
data/__database__.db
data/__database__.db-dump
data/__database__.db-journal

# Logs
data/bot.log

# User-supplied assets (fonts are tracked, everything else here is not)
data/images/*
data/images.zip
test_images/

# Env / tooling
env
.claude/
